VERSERP_ENV=production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Homologação interna temporária por HTTP: false.
# Produção definitiva por HTTPS: true.
DJANGO_HTTPS_ENABLED=false
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
